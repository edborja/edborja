  - name: Fetch trophy image
    run: |
      mkdir -p assets
      TROPHY_URL="https://github-profile-trophy.vercel.app/?username=edborja&theme=tokyonight&no-frame=true&no-bg=true&margin-w=15"
      echo "Fetching $TROPHY_URL"
      # Try to download; if it fails (e.g. 402) exit gracefully without creating a file
      if curl -sSL --fail "$TROPHY_URL" -o assets/github-trophy.png; then
        echo "Trophy image downloaded"
      else
        echo "Failed to fetch trophy (upstream may return 402). Exiting without changes."
        exit 0
      fi

  - name: Commit and push if changed
    run: |
      git config user.name "github-actions[bot]"
      git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
      git add assets/github-trophy.png
      if git diff --cached --quiet; then
        echo "No changes to commit"
        exit 0
      fi
      git commit -m "ci(cache): update cached github-profile-trophy image"
      git push
    env:
      GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
